{
  "name": "supply-chain",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack -H 127.0.0.1",
    "dev:webpack": "NEXT_DIST_DIR=.next-webpack next dev -H 127.0.0.1",
    "dev:jobs": "SCM_RUN_JOBS=1 NEXT_DIST_DIR=.next-dev next dev --turbopack -H 127.0.0.1",
    "dev:session": "node --import tsx scripts/dev-session.ts",
    "scm": "node --import tsx scripts/scm.ts",
    "clean:cache": "node --import tsx scripts/clean-caches.ts",
    "build": "next build && node --import tsx scripts/sanitize-standalone.ts && node --import tsx scripts/normalize-next-env.ts",
    "start": "next start",
    "postinstall": "node scripts/patch-minimatch-brace-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:test && npm run typecheck:scripts",
    "test": "vitest run",
    "test:fast": "vitest run tests/rules tests/architecture tests/components",
    "test:changed": "vitest --changed --run --passWithNoTests",
    "test:watch": "vitest",
    "check:fast": "node --import tsx scripts/verify-fast.ts",
    "check:pr": "npm run lint:full && npm run typecheck:all && npm test",
    "check:release": "node --import tsx scripts/verify-release.ts",
    "check:ops": "bash -n ops/backup.sh ops/check-backup.sh ops/restore-drill.sh ops/deploy.sh && node --import tsx scripts/verify-ops.ts",
    "check:postgres": "node --import tsx scripts/verify-postgres.ts",
    "check:postgres:jdy-concurrency": "node --import tsx scripts/verify-postgres-jdy-concurrency.ts",
    "check:postgres:sku-identity-concurrency": "node --import tsx scripts/verify-postgres-sku-identity-concurrency.ts",
    "check:postgres:review-atomicity": "node --import tsx scripts/verify-postgres-review-atomicity.ts",
    "check:postgres:yonyou-concurrency": "node --import tsx scripts/verify-postgres-yonyou-concurrency.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "admin:reset-local": "node --import tsx scripts/reset-local-admin.ts",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint --concurrency auto --max-warnings=0",
    "lint:full": "eslint . --no-cache --max-warnings=0",
    "db:backup": "tsx scripts/backup-dev-db.ts",
    "db:restore": "tsx scripts/backup-dev-db.ts --restore",
    "db:restore-drill": "tsx scripts/restore-drill-dev.ts",
    "db:restore-drill:prod": "ops/restore-drill.sh",
    "data:audit": "node --import tsx scripts/audit-data-lineage.ts",
    "data:queue-reference-aliases": "node --import tsx scripts/queue-reference-aliases.ts",
    "data:repair-import-statuses": "node --import tsx scripts/repair-import-job-statuses.ts",
    "data:backfill-snapshot-lineage": "node --import tsx scripts/backfill-snapshot-lineage.ts",
    "data:backfill-npd-lineage": "node --import tsx scripts/backfill-npd-lineage.ts",
    "readiness": "tsx scripts/connector-readiness.ts",
    "yy:probe": "tsx scripts/yonyou-probe.ts",
    "jst:auth-url": "tsx scripts/jst-auth-url.ts",
    "jdy:survey": "tsx scripts/jiandaoyun-survey.ts",
    "jdy:barcode-gap": "tsx scripts/jiandaoyun-barcode-gap.ts",
    "jst:init-token": "tsx scripts/jst-init-token.ts",
    "lan:sync": "bash scripts/sync-lan-auth-url.sh",
    "lan:alias": "bash scripts/install-mdns-alias.sh",
    "lan:alias:remove": "bash scripts/remove-mdns-alias.sh",
    "access:public": "bash scripts/install-public-tunnel.sh",
    "access:public:remove": "bash scripts/remove-public-tunnel.sh",
    "access:link": "bash scripts/show-access-link.sh",
    "access:tunnel": "bash scripts/setup-public-tunnel.sh",
    "access:tailscale": "bash scripts/setup-tailscale-access.sh"
  },
  "dependencies": {
    "@ant-design/cssinjs": "1.24.0",
    "@ant-design/icons": "5.6.1",
    "@ant-design/nextjs-registry": "^1.0.2",
    "@next/env": "15.5.22",
    "@node-rs/argon2": "^2.0.2",
    "antd": "5.29.3",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "fflate": "^0.8.3",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.2",
    "pinyin-pro": "3.28.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "cron-parser": "^4.9.0",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "js-yaml": "4.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  }
}
