# 无 systemd 环境的备份调度替代（二选一：systemd timer 或 cron，勿双装）。
# 安装：crontab -e 后粘贴（把 /opt/supply-chain 换成实际部署目录）。
# CRON_TZ 需 cronie/vixie-cron 支持；不支持时确认主机时区为 Asia/Shanghai。
CRON_TZ=Asia/Shanghai

# 每日 02:30 备份（DB + 附件卷，出主机见 BACKUP_REMOTE）
30 2 * * * /opt/supply-chain/ops/backup.sh >> /var/log/scm-backup.log 2>&1

# 每小时备份新鲜度检查：最新备份 >25h 视为断档，非零退出接告警通道
0 * * * * /opt/supply-chain/ops/check-backup.sh >> /var/log/scm-backup-check.log 2>&1
