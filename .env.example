# 本地零依赖数据库（联调 PostgreSQL URL 见 README）
DATABASE_URL=pglite:.data/dev

# 生产 Compose：复制为 .env.prod 后必须改成强随机值
POSTGRES_PASSWORD=change-me-generate-a-strong-database-password

# NextAuth
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_URL=http://127.0.0.1:3000

# 飞书 OAuth 登录 + 应用机器人（机器人还需目标群 chat_id）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# 飞书自定义机器人独立路径（只接受 https://open.feishu.cn/open-apis/bot/v2/hook/...）
FEISHU_WEBHOOK_URL=
# 应用机器人和 webhook 必须分别完成真实群 UAT；时间与非秘密证据编号必须成对存在
FEISHU_APP_LIVE_VERIFIED_AT=
FEISHU_APP_LIVE_VERIFIED_REF=
FEISHU_WEBHOOK_LIVE_VERIFIED_AT=
FEISHU_WEBHOOK_LIVE_VERIFIED_REF=

# 聚水潭开放平台：应用凭据 + access token + 系统内启用责任人
JST_APP_KEY=
JST_APP_SECRET=
JST_ACCESS_TOKEN=
JST_SYNC_ACTOR_ID=
# 可选；只接受 https://openapi.jushuitan.com，避免签名/token 被发送到非官方主机
JST_BASE_URL=
# 库存接口仅作为跨仓总量增量观察进入 staging；显式启用后才调度，绝不直接写库存账
JST_INVENTORY_SYNC_ENABLED=false
# 仅在真实日控制总量与恢复 UAT 通过后填写；时间与非秘密证据编号必须同时存在
JST_LIVE_VERIFIED_AT=
JST_LIVE_VERIFIED_REF=

# 简道云 OpenAPI（现行低代码 ERP）：目录 + 显式观察契约，只进 evidence/staging
JIANDAOYUN_API_KEY=
JIANDAOYUN_SYNC_ACTOR_ID=
# 必须显式开启；默认不因仅有凭据而拉取业务数据
JIANDAOYUN_SYNC_ENABLED=false
# 逗号分隔；可选 key 见 src/server/integrations/jiandaoyun-contracts.ts
JIANDAOYUN_SYNC_CONTRACTS=
# 可选；只接受 https://api.jiandaoyun.com/api/v5，避免 API key 被发送到非官方主机
JIANDAOYUN_BASE_URL=
# 仅在目录、字段最小化、重复视图和控制总量 UAT 通过后填写；时间与非秘密证据编号必须同时存在
JIANDAOYUN_LIVE_VERIFIED_AT=
JIANDAOYUN_LIVE_VERIFIED_REF=

# 用友 OpenAPI 企业应用（C4 人工登录账号不能替代以下机器凭据）
YY_APP_KEY=
YY_APP_SECRET=
YY_TENANT_ID=
YY_ORG_ID=
# c4 / yonsuite / yonbip；必须由实施方确认，不从登录网址猜测
YY_PRODUCT_PROFILE=
# 企业已授权的精确 API 契约名/版本，逗号分隔；不能只写“采购/财务”等泛称
YY_APPROVED_API_CONTRACTS=
# 企业/实施方确认的 base/token 精确主机名，逗号分隔，不接受通配符、IP 或任意公网域名
YY_ALLOWED_HOSTS=
YY_BASE_URL=
YY_TOKEN_URL=

# 附件卷
FILE_STORAGE_DIR=./uploads
