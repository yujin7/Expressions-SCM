{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": ".cache/tsconfig.test.tsbuildinfo",
    "plugins": [],
    "types": ["node", "vitest/globals"]
